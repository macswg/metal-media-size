{
  "name": "metal-media-size",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:all": "vitest run",
    "test:integration": "vitest run test/scan.integration.test.ts",
    "scan": "node --experimental-strip-types src/cli/scan.ts",
    "serve": "node --experimental-strip-types src/cli/serve.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.0"
  }
}
